{
  "name": "fantasy-ops",
  "version": "1.0.0",
  "description": "Fantasy Sports Operations Management System",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "build": "npm run lint && npm test",
    "package": "pkg . --out-path dist",
    "package:win": "pkg . --target node18-win-x64 --out-path dist",
    "package:linux": "pkg . --target node18-linux-x64 --out-path dist",
    "package:mac": "pkg . --target node18-macos-x64 --out-path dist",
    "package:all": "pkg . --target node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist"
  },
  "pkg": {
    "scripts": "server/**/*.js",
    "assets": [
      "public/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "fantasy",
    "sports",
    "management",
    "league"
  ],
  "author": "Fantasy Ops Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.9.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
